<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXA — One Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<div id="loginScreen">
  <div class="login-bg" id="loginBg"></div>

  <div class="login-brand-mark">
    <span class="login-brand">NEXA</span>
    <span class="login-brand-sub">ONE INTELLIGENCE.</span>
  </div>
  <div class="login-mission"><span class="mission-orb">◈</span> Built for a brighter Africa</div>

  <div class="login-panel glass-card">
    <div class="login-orb" aria-hidden="true"><span></span></div>
    <h1 class="login-title">Welcome to NEXA</h1>
    <p class="login-subtitle">The essential gateway to many possibilities.</p>

    <form class="login-form" autocomplete="off">
      <label class="field-label login-field">
        <span class="field-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z" fill="currentColor"/></svg>
        </span>
        <input type="email" value="" aria-label="Email" placeholder="Username or Email" required />
      </label>

      <label class="field-label password-field login-field">
        <span class="field-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-6 6.73V16a1 1 0 0 1 2 0v-.27a2 2 0 1 1-2 0zm3-6.73H10V7a2 2 0 0 1 4 0v2z" fill="currentColor"/></svg>
        </span>
        <input type="password" value="" aria-label="Password" placeholder="Password" required />
        <button class="field-visibility" id="togglePassword" type="button" aria-label="Show password" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 2l20 20M9.9 9.9a3 3 0 0 0 4.2 4.2M6.7 6.7C4.5 8 2.9 9.8 2 12c1.8 4.2 5.5 7 10 7 1.7 0 3.3-.4 4.7-1.1M17.3 17.3C19.5 16 21.1 14.2 22 12c-1.8-4.2-5.5-7-10-7-1.7 0-3.3.4-4.7 1.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </label>

      <button class="login-button login-enter" id="loginEnter" type="submit">Login</button>

      <div class="login-meta-row login-options">
        <label class="remember-me">
          <input type="checkbox" checked />
          <span>Remember me</span>
        </label>
        <a href="#">Forget password?</a>
      </div>

      <div class="login-divider"><span>or continue with</span></div>
      <div class="login-socials" aria-label="Social sign in options">
        <button type="button" aria-label="Continue with Google"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.8 3-4.4 3-7.3z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.5l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2H3.1v2.6A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.4 13.8a6 6 0 0 1 0-3.6V7.6H3.1a10 10 0 0 0 0 8.8l3.3-2.6z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.6l3.3 2.6C7.2 7.8 9.4 6 12 6z"/></svg></button>
        <button type="button" aria-label="Continue with Microsoft"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#f35325" d="M2 2h9.5v9.5H2z"/><path fill="#81bc06" d="M12.5 2H22v9.5h-9.5z"/><path fill="#05a6f0" d="M2 12.5h9.5V22H2z"/><path fill="#ffba08" d="M12.5 12.5H22V22h-9.5z"/></svg></button>
        <button type="button" aria-label="Continue with GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.2-4.5-1.1-4.5-4.8 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.5 9.5 0 0 1 5.1 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.7-2.3 4.6-4.5 4.8.4.3.7 1 .7 1.9v2.8c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.5z"/></svg></button>
      </div>
      <div class="login-register">One Africa. Infinite Possibilities.</div>
    </form>
  </div>

  <div class="login-quote">“Intelligence<br>for a better Africa.”<span></span></div>
  <div class="login-location">&#128205; Diani, Kenya</div>
  <div class="login-dots"><b></b><i></i><i></i><i></i></div>
</div>

<div id="app">

  <header class="topbar">
    <div class="logo">
      <h1><span class="text-gradient">NEXA</span></h1>
      <p>ONE INTELLIGENCE.</p>
    </div>
    <div class="search-bar header-search">
      <span class="search-icon" aria-hidden="true">&#128269;</span>
      <input type="text" id="searchInput" class="search-input" placeholder="Ask NEXA anything..." autocomplete="off">
      <span class="search-shortcut">Ctrl&nbsp;&nbsp;K</span>
    </div>
    <div class="header-right">
      <button class="theme-toggle" type="button" aria-label="Toggle theme">&#9788;</button>
      <div class="profile glass-card-hover"><span class="profile-avatar">B</span><span>Bill</span><span aria-hidden="true">&#8964;</span></div>
    </div>
  </header>

  <div class="shell">

    <aside class="rail">
      <div class="rail-item active" data-view="home" title="Home">
        <span class="rail-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></span>
        <span class="rail-label">Home</span>
      </div>
      <div class="rail-item" data-view="chat" title="Chat">
        <span class="rail-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.6 8.6 0 0 1-3.2-.6L4 20l1.6-3.7A7.4 7.4 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5z"/></svg></span>
        <span class="rail-label">Chat</span>
      </div>
      <div class="rail-item" data-view="skills" title="Skills">
        <span class="rail-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 9-12h-7z"/></svg></span>
        <span class="rail-label">Skills</span>
      </div>
      <div class="rail-item" data-view="home" title="Knowledge">
        <span class="rail-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21zm0 0v15.5M8 7h8M8 11h8"/></svg></span>
        <span class="rail-label">Knowledge</span>
      </div>
      <div class="rail-item" data-view="home" title="History">
        <span class="rail-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.6M4 4v4.6h4.6"/></svg></span>
        <span class="rail-label">History</span>
      </div>
      <div class="rail-spacer"></div>
      <div class="rail-item" data-view="home" title="Settings">
        <span class="rail-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm8-3.2 2-1.2-2-3.4-2.1.8a7.7 7.7 0 0 0-1.5-.9L16 5h-4l-.4 2.3a7.7 7.7 0 0 0-1.5.9L8 7.4 6 10.8 8 12a7.5 7.5 0 0 0 0 1.8L6 15.2l2 3.4 2.1-.8c.5.4 1 .7 1.5.9L12 21h4l.4-2.3c.5-.2 1-.5 1.5-.9l2.1.8 2-3.4-2-1.4a7.5 7.5 0 0 0 0-1.8z"/></svg></span>
        <span class="rail-label">Settings</span>
      </div>
    </aside>

    <main class="workspace">

      <div id="searchResultHint" class="search-result-hint"></div>

      <div id="viewHome">

        <div class="hero-card hero-with-photo">
          <div class="hero-bg-photo"></div>
          <div class="hero-orb-wrap">
            <div class="jarvis-orb" id="jarvisOrb">
              <div class="orb-rings">
                <div class="orb-ring ring-1"></div>
                <div class="orb-ring ring-2"></div>
                <div class="orb-ring ring-3"></div>
              </div>
              <div class="orb-core"></div>
            </div>
          </div>
          <div class="hero-text">
            <h2>One Intelligence.</h2>
            <p class="hero-sub">The essential gateway to many possibilities.</p>
            <div class="hero-divider">AFRICA <span>•</span> PEOPLE <span>•</span> KNOWLEDGE <span>•</span> IMPACT</div>
          </div>
        </div>

        <div class="module-grid">
          <div class="module-card" data-skill="agriculture.crop_advisor">
            <div class="module-icon leaf"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4C10 4 5 8 5 15c0 2.2 1.8 4 4 4 7 0 11-5 11-15zM4 21c3-5 6-8 11-11"/></svg></div>
            <div class="module-title">Agriculture</div>
            <div class="module-sub">Sustainable food systems</div>
            <span class="module-action" aria-hidden="true">&#8594;</span>
          </div>
          <div class="module-card" data-skill="education.study_advisor">
            <div class="module-icon book"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6c-2-2-5-3-9-3v16c4 0 7 1 9 3 2-2 5-3 9-3V3c-4 0-7 1-9 3zM12 6v16"/></svg></div>
            <div class="module-title">Education</div>
            <div class="module-sub">Skills for a brighter future</div>
            <span class="module-action" aria-hidden="true">&#8594;</span>
          </div>
          <div class="module-card" data-skill="entrepreneurship.reference_advisor">
            <div class="module-icon bulb"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 22h4M8.5 14.5A6 6 0 1 1 15.5 14c-.9.8-1.5 1.8-1.5 3h-4c0-1.1-.6-1.7-1.5-2.5z"/></svg></div>
            <div class="module-title">Innovation</div>
            <div class="module-sub">Ideas into impact</div>
            <span class="module-action" aria-hidden="true">&#8594;</span>
          </div>
          <div class="module-card" data-view="skills">
            <div class="module-icon globe"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></div>
            <div class="module-title">Africa</div>
            <div class="module-sub">One people, many possibilities</div>
            <span class="module-action" aria-hidden="true">&#8594;</span>
          </div>
        </div>

        <div class="glass-card wood-accent" style="display:none;">
          <h2 class="pipeline-title">Execution Pipeline</h2>
          <div class="pipeline" id="pipeline">
            <div class="pipeline-stage" data-stage="0"><span>Decision</span><div class="stage-dot"></div></div>
            <div class="pipeline-arrow">&#8594;</div>
            <div class="pipeline-stage" data-stage="1"><span>Planner</span><div class="stage-dot"></div></div>
            <div class="pipeline-arrow">&#8594;</div>
            <div class="pipeline-stage" data-stage="2"><span>Orchestrator</span><div class="stage-dot"></div></div>
            <div class="pipeline-arrow">&#8594;</div>
            <div class="pipeline-stage" data-stage="3"><span>Dispatcher</span><div class="stage-dot"></div></div>
            <div class="pipeline-arrow">&#8594;</div>
            <div class="pipeline-stage" data-stage="4"><span>Authorization</span><div class="stage-dot"></div></div>
            <div class="pipeline-arrow">&#8594;</div>
            <div class="pipeline-stage" data-stage="5"><span>Executor</span><div class="stage-dot"></div></div>
          </div>
        </div>

      </div>

      <div id="viewChat" class="hidden-view">
        <div class="glass-card wood-accent chat-card">
          <h2 class="pipeline-title">Chat</h2>
          <p class="hero-sub" style="margin-bottom:16px;">
            NEXA matches what you type against its real skill catalog by keyword —
            this is not open-ended conversation yet, just a direct line to a matching skill.
          </p>
          <div id="chatLog" class="chat-log"></div>
          <div class="chat-input-row">
            <input type="text" id="chatInput" class="chat-input" placeholder="Type a question…" autocomplete="off">
            <div class="glass-card-hover" id="chatSendButton" style="cursor:pointer;">Send</div>
          </div>
        </div>
      </div>

      <div id="viewSkills" class="hidden-view">
        <div class="glass-card wood-accent">
          <h2 class="pipeline-title">Skills</h2>
          <p class="hero-sub" style="margin-bottom:16px;">Only builtin skills are reachable here — privileged skills (voice, image, reasoning, shutdown) require founder access and are not exposed to the web client.</p>
          <div id="skillsList" class="skills-run-list">Loading…</div>
        </div>

        <div class="glass-card wood-accent" id="skillRunCard" style="display:none;">
          <h2 class="pipeline-title" id="skillRunTitle">Run skill</h2>
          <p class="hero-sub" id="skillRunDescription"></p>
          <textarea id="skillRunParams" class="skill-params-input" placeholder='{"subject": "example"}'></textarea>
          <div class="skill-run-actions">
            <div class="glass-card-hover" id="skillRunButton" style="cursor:pointer;">Run</div>
            <div class="glass-card-hover" id="skillRunCancel" style="cursor:pointer;">Cancel</div>
          </div>
          <pre id="skillRunResult" class="skill-run-result"></pre>
        </div>
      </div>

    </main>

    <aside class="right-panel">
    </aside>
  </div>

  <footer>
    <div class="footer-content">
      <div class="footer-block footer-left">Built for Africa<br>by Africans.</div>
      <div class="footer-block footer-center">“Intelligence for a better Africa.”</div>
      <div class="footer-block footer-right">&#128205; Mount Kenya, Kenya<br><span>Tue, 14 Jan 2025&nbsp; • &nbsp;07:24 AM</span></div>
    </div>
  </footer>
</div>

<script src="script.js"></script>
</body>
</html>