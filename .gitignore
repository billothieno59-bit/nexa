# ==========================
# NEXA Africa Operating System
# Canonical .gitignore
# ==========================

# Python virtual environments
venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/

# Ruff
.ruff_cache/

# Coverage
.coverage
htmlcov/
.coverage.*

# Logs
*.log
logs/
log/

# Build artifacts
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Local databases
*.sqlite3-journal

# Local models (downloaded separately)
models/

# Runtime outputs
output/
outputs/
uploads/
cache/
caches/
.next/